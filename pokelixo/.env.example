# =========================================================================
# CONFIGURAÇÃO DO BANCO DE DADOS MYSQL (POKÉTIBIA / TFS)
# =========================================================================
# Adicione estas variáveis no arquivo .env.local (para testes locais)
# e no painel da Vercel (Project Settings -> Environment Variables) para produção.

# IP ou Domínio da VPS onde roda o MySQL do PokéTibia (ex: 127.0.0.1 ou o IP da sua VPS)
DB_HOST=127.0.0.1

# Porta do MySQL (o padrão é 3306)
DB_PORT=3306

# Usuário do MySQL (geralmente root)
DB_USER=root

# Senha do MySQL do seu servidor
DB_PASSWORD=sua_senha_aqui

# Nome da Database do seu PokéTibia (ex: poketibia ou otserv)
DB_NAME=poketibia

# Tipo de Hash de senha usado no seu config.lua do TFS:
# "sha1" (padrão de praticamente todos os servidores de PokéTibia/TFS) ou "plain"
DB_HASH_TYPE=sha1

# =========================================================================
# CONFIGURAÇÃO DE ENVIO DE E-MAILS (RESEND)
# =========================================================================
# Crie uma conta gratuita em https://resend.com e gere uma API Key
RESEND_API_KEY=re_123456789abcdef
# Remetente (onboarding@resend.dev é gratuito para testes sem precisar de domínio)
RESEND_FROM_EMAIL=PokéTibia <onboarding@resend.dev>

